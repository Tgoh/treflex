{
	"name": "treflex-react-portal",
	"private": true,
	"type": "module",
	"description": "The treflex demo portal, rendered through treflex-react",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"treflex": "file:../../packages/core",
		"treflex-react": "file:../../packages/react"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/node": "^24.0.3",
		"@types/react": "19.1.2",
		"@types/react-dom": "19.1.2",
		"@vitejs/plugin-react": "5.2.0",
		"jsdom": "29.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.4"
	}
}
