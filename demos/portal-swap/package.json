{
	"name": "treflex-portal-swap",
	"private": true,
	"type": "module",
	"description": "The treflex demo portal, swapping between its Solid and React views in place",
	"scripts": {
		"dev": "vite",
		"build": "npm run typecheck && vite build",
		"typecheck": "tsc --noEmit -p tsconfig.solid.json && tsc --noEmit -p tsconfig.react.json",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"solid-js": "^1.9.7",
		"treflex": "file:../../packages/core",
		"treflex-react": "file:../../packages/react",
		"treflex-solid": "file:../../packages/solid"
	},
	"devDependencies": {
		"@types/node": "^24.0.3",
		"@types/react": "19.1.2",
		"@types/react-dom": "19.1.2",
		"@vitejs/plugin-react": "4.4.1",
		"jsdom": "29.1.1",
		"typescript": "^7.0.2",
		"vite": "^6.3.5",
		"vite-plugin-solid": "^2.11.7",
		"vitest": "^4.1.4"
	}
}
