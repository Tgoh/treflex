{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"customConditions": [
			"treflex-source"
		],
		"declaration": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": [
			"vite/client"
		],
		"verbatimModuleSyntax": true
	},
	"include": [
		"./src"
	]
}
