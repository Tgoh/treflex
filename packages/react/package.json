{
	"name": "treflex-react",
	"version": "0.1.0",
	"description": "React bindings for treflex",
	"license": "MIT",
	"author": "Tam Goh",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tgoh/treflex.git",
		"directory": "packages/react"
	},
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "node ../../scripts/build.mjs",
		"prepack": "node ../../scripts/build.mjs --pack",
		"postpack": "node ../../scripts/build.mjs --unpack"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"treflex-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"react": "^19.1.0",
		"solid-js": "^1.9.7",
		"treflex": "0.1.0"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@types/react": "19.1.2",
		"@types/react-dom": "19.1.2",
		"jsdom": "29.1.1",
		"react": "19.1.0",
		"react-dom": "19.1.0"
	}
}
