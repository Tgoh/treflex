{
	"name": "treflex-solid",
	"version": "0.3.0",
	"description": "Solid bindings for treflex",
	"license": "MIT",
	"author": "Tam Goh",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tgoh/treflex.git",
		"directory": "packages/solid"
	},
	"type": "module",
	"sideEffects": [
		"./src/index.ts",
		"./dist/index.js",
		"./src/Context/TreflexContext.tsx",
		"./dist/Context/TreflexContext.js"
	],
	"scripts": {
		"build": "node ../../scripts/build.mjs",
		"prepack": "node ../../scripts/build.mjs --pack",
		"postpack": "node ../../scripts/build.mjs --unpack"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"treflex-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./internal": {
			"treflex-source": "./src/internal.ts",
			"types": "./dist/internal.d.ts",
			"import": "./dist/internal.js"
		}
	},
	"peerDependencies": {
		"@solidjs/web": "^2.0.3",
		"solid-js": "^2.0.3",
		"treflex": "0.3.0"
	},
	"devDependencies": {
		"jsdom": "29.1.1"
	}
}
