{
	"name": "treflex",
	"version": "0.1.1",
	"description": "A runtime for app state and the work running on it, for Solid and React",
	"license": "MIT",
	"author": "Tam Goh",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Tgoh/treflex.git",
		"directory": "packages/core"
	},
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "node ../../scripts/build.mjs",
		"prepack": "node ../../scripts/build.mjs --pack",
		"postpack": "node ../../scripts/build.mjs --unpack"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"biome",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"treflex-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./snapshot": {
			"treflex-source": "./src/Snapshot/index.ts",
			"types": "./dist/Snapshot/index.d.ts",
			"import": "./dist/Snapshot/index.js"
		},
		"./internal": {
			"treflex-source": "./src/internal.ts",
			"types": "./dist/internal.d.ts",
			"import": "./dist/internal.js"
		}
	},
	"dependencies": {
		"solid-js": "^1.9.7",
		"uuid": "^11.1.0"
	}
}
