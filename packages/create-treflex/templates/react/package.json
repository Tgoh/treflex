	},
	"dependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"treflex": "*",
		"treflex-react": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^10.9.1",
		"jsdom": "^29.1.1",
		"treflex-eslint": "*",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.4"
	}
